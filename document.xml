      <TextLine id="region_005_line_001">
        <Coords points="108,738 1449,742 1448,795 108,791"/>
        <TextEquiv>
          <Unicode>Heute habe ich meinem zahmen Rotkehlchen die Frei-</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="region_005_line_002">
        <Coords points="27,796 1452,805 1450,863 25,854"/>
        <TextEquiv>
          <Unicode>heit gegeben. Ich stellte den Käfig mit geöffneter Tür an das</Unicode>
