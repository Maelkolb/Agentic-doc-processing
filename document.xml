      <TextLine id="region_005_line_008">
        <Coords points="28,1162 1455,1162 1455,1215 28,1215"/>
        <TextEquiv>
          <Unicode>Tagsüber hörte ich es im Garten noch manchmal zwitschern.</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="region_005_line_009">
        <Coords points="28,1221 1453,1225 1452,1277 27,1273"/>
        <TextEquiv>
          <Unicode>Aus Mangel an Ringen konnte ich den Vogel leider nicht zeich-</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="region_005_line_010">
        <Coords points="25,1290 140,1293 136,1323 21,1320"/>
        <TextEquiv>
          <Unicode>nen.</Unicode>
        </TextEquiv>
      </TextLine>
      <TextEquiv>
        <Unicode>Heute habe ich meinem zahmen Rotkehlchen die Frei-
heit gegeben. Ich stellte den Käfig mit geöffneter Tür an das
offene Fenster, wie gewohnt kam das Vögelchen heraus, er-
staunt über die unbegrenzte Freiheit, die sich vor ihm auf-
tat. Auf der Fensterbank machte es noch ein paar Knixe, kam
dann nochmals an seinen Käfig, wie um Abschied zu neh-
men und verschwand dann raschen Fluges in der Freiheit.
Tagsüber hörte ich es im Garten noch manchmal zwitschern.
Aus Mangel an Ringen konnte ich den Vogel leider nicht zeich-
nen.</Unicode>
      </TextEquiv>
    </TextRegion>
