      </TextLine>
      <TextLine id="region_005_line_004">
        <Coords points="21,922 1462,924 1462,980 21,978"/>
        <TextEquiv>
          <Unicode>staunt über die unbegrenzte Freiheit, die sich vor ihm auf-</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="region_005_line_005">
        <Coords points="21,981 1480,981 1480,1036 21,1036"/>
        <TextEquiv>
          <Unicode>tat. Auf der Fensterbank machte es noch ein paar Knixe, kam</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="region_005_line_006">
        <Coords points="25,1038 1463,1043 1462,1100 24,1095"/>
        <TextEquiv>
          <Unicode>dann nochmals an seinen Käfig, wie um Abschied zu neh-</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="region_005_line_007">
        <Coords points="21,1102 1480,1102 1480,1159 21,1159"/>
        <TextEquiv>
          <Unicode>men und verschwand dann raschen Fluges in der Freiheit.</Unicode>
